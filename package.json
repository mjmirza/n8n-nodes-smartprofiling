{
	"name": "n8n-nodes-smartprofiling",
	"version": "0.3.1",
	"description": "n8n community node for Smart Profiling - Extract transcripts, generate AI summaries, and chat with YouTube videos",
	"license": "MIT",
	"homepage": "https://smartprofiling.com",
	"keywords": [
		"n8n-community-node-package",
		"youtube",
		"transcript",
		"video",
		"summarize",
		"caption",
		"subtitle",
		"ai",
		"smart",
		"profiling"
	],
	"author": {
		"name": "Smart Profiling",
		"email": "support@smartprofiling.com"
	},
	"scripts": {
		"build": "n8n-node build",
		"build:watch": "tsc --watch",
		"dev": "n8n-node dev",
		"lint": "n8n-node lint",
		"lint:fix": "n8n-node lint --fix",
		"release": "n8n-node release",
		"prepublishOnly": "n8n-node prerelease",
		"test": "npm run lint && npm run build && node --test test/*.test.cjs"
	},
	"files": [
		"dist",
		"!dist/tsconfig.tsbuildinfo"
	],
	"n8n": {
		"n8nNodesApiVersion": 1,
		"credentials": [
			"dist/credentials/SmartProfilingApi.credentials.js"
		],
		"nodes": [
			"dist/nodes/SmartProfiling/SmartProfiling.node.js"
		]
	},
	"devDependencies": {
		"@n8n/node-cli": "^0.54.6",
		"eslint": "^10.14.0",
		"prettier": "3.6.2",
		"release-it": "^19.0.4",
		"typescript": "5.9.2"
	},
	"peerDependencies": {
		"n8n-workflow": "*"
	},
	"engines": {
		"node": ">=18.0.0"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/mjmirza/n8n-nodes-smartprofiling.git"
	},
	"bugs": {
		"url": "https://github.com/mjmirza/n8n-nodes-smartprofiling/issues"
	},
	"publishConfig": {
		"access": "public",
		"provenance": true
	}
}
